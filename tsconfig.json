{
    "compilerOptions": {
      "target": "ES2024",
      "outDir": "lib",
      "lib": [
        "dom",
        "dom.iterable",
        "esnext"
      ],
      "declaration": true,
      "declarationDir": "lib",
      "rootDir": "src",
      "allowJs": true,
      "skipLibCheck": true,
      "esModuleInterop": true,
      "strict": true,
      "module": "esnext",
      "moduleResolution": "bundler",
      "resolveJsonModule": true,
      "noEmit": true,
      "jsx": "react-jsx"
    },
    "include": [
      "src"
    ],
    "exclude": [
        "node_modules",
        "lib",
        "src/stories"
    ]
  }