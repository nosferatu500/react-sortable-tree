{
  /* No `rootDir` on purpose. This project is `noEmit` — tsdown does the emitting
   * (including .d.ts) — so `rootDir` bought nothing except forbidding any
   * included file above `src`, which left tsdown.config.ts in no project at all:
   * editors fell back to an inferred project (hence spurious "cannot find
   * node:fs/promises, install @types/node" reports) and `npm run typecheck`
   * silently skipped it. Re-adding `rootDir` reintroduces both problems. */
  "compilerOptions": {
    "target": "ES2025",
    "outDir": "lib",
    "lib": ["dom", "dom.iterable", "es2025"],
    "declaration": true,
    "declarationDir": "lib",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "isolatedDeclarations": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "noEmit": true,
    "jsx": "react-jsx"
  },
  /* `test/` is deliberately absent: it imports the built `lib/`, which does not
   * exist on a clean checkout — and `typecheck` runs as `prebuild`, before it is
   * built. Those are smoke tests over compiler output, not type tests. */
  "include": [
    "src",
    "tsdown.config.ts",
    "vitest.config.ts",
    "vitest.build.config.ts",
    "vitest.setup.ts"
  ],
  "exclude": ["node_modules", "lib"]
}
