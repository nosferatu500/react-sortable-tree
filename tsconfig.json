{
  "compilerOptions": {
    "target": "ES2025",
    "outDir": "lib",
    "lib": ["dom", "dom.iterable", "es2025"],
    "declaration": true,
    "declarationDir": "lib",
    "rootDir": "src",
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "strict": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "noEmit": true,
    "jsx": "react-jsx"
  },
  "include": ["src"],
  "exclude": ["node_modules", "lib"]
}
